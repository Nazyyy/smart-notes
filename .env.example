# ### FILE: .env.example
# ==============================================================================
# SMART NOTES - APPLICATION CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Application Security & Host
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501", "http://localhost:3000"]

# PostgreSQL Database Configuration
POSTGRES_USER=smart_notes_user
POSTGRES_PASSWORD=smart_notes_secret_password_2026
POSTGRES_DB=smart_notes_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://smart_notes_user:smart_notes_secret_password_2026@postgres:5432/smart_notes_db

# Storage Configuration
STORAGE_ROOT=/app/data/storage
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 Megabytes
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp", "bmp", "tiff"]

# PyTorch / ML Inference Configuration
ML_MODEL_WEIGHTS_PATH=/app/data/weights/crnn_htr_weights.pt
ML_DEVICE=cpu                   # Set to "cuda" if GPU is available
ML_BATCH_SIZE=16
ML_BEAM_WIDTH=5
ML_BLANK_INDEX=0

# Frontend Configuration
BACKEND_API_URL=http://backend:8000/api/v1
