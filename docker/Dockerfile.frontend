# ### FILE: docker/Dockerfile.frontend
# ==============================================================================
# SMART NOTES - PRODUCTION MULTI-STAGE DOCKERFILE FOR STREAMLIT FRONTEND
# Hardened non-root user, lightweight runtime
# ==============================================================================

FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir streamlit requests pillow

# ------------------------------------------------------------------------------
# RUNTIME STAGE
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10002 streamlitgroup && \
    useradd -u 10002 -g streamlitgroup -s /bin/bash -m streamlituser

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED=1

RUN mkdir -p /app/frontend /app/data/storage && \
    chown -R streamlituser:streamlitgroup /app

COPY --chown=streamlituser:streamlitgroup frontend /app/frontend

USER streamlituser

EXPOSE 8501

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false"]
